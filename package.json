{
  "name": "simplelocal-ai",
  "version": "1.0.16",
  "description": "A local desktop application for chatting with documents - 100% offline, 100% private",
  "main": "dist/main/index.js",
  "author": "SimpleLocal AI Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "download-models": "node scripts/download-models.js",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.0",
    "node-llama-cpp": "^3.0.0",
    "@lancedb/lancedb": "^0.13.0",
    "apache-arrow": "^17.0.0",
    "electron-store": "^10.0.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "uuid": "^10.0.0",
    "sharp": "^0.32.0",
    "onnxruntime-node": "1.14.0",
    "onnxruntime-common": "1.14.0",
    "color": "^4.2.3",
    "color-convert": "^3.1.3",
    "color-name": "^2.0.0",
    "color-string": "^2.1.3",
    "@huggingface/jinja": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.simplelocal.ai",
    "productName": "SimpleLocal AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/color/**/*",
      "node_modules/color-convert/**/*",
      "node_modules/color-name/**/*",
      "node_modules/color-string/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/@lancedb/**/*",
      "node_modules/@xenova/**/*",
      "node_modules/node-llama-cpp/**/*",
      "node_modules/apache-arrow/**/*",
      "node_modules/semver/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/prebuild-install/**/*"
    ],
    "win": {
      "target": ["zip"],
      "artifactName": "${productName}-${version}-win.zip"
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
